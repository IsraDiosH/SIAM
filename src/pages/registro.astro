---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Registro | FAM Congress">
  <div class="mx-auto max-w-6xl pb-12">
    <div class="mb-8 flex items-center justify-between gap-4">
      <div>
        <p class="mb-2 text-xs font-bold uppercase tracking-[0.2em] text-[#28666a]">Inscripción</p>
        <h1 class="text-4xl font-black tracking-[-0.06em] text-[#153d40] md:text-5xl">Registro y pago</h1>
      </div>
      <a href="/" class="rounded-full border border-[#c8d5d4] bg-white px-4 py-2 text-sm font-semibold text-[#153d40] transition hover:border-[#153d40] hover:text-[#153d40]">
        ← Volver al inicio
      </a>
    </div>

    <div id="payment-feedback" class="mb-6 hidden rounded-2xl border px-4 py-3 text-sm font-semibold"></div>

    <div class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr]">
      <section class="rounded-[28px] border border-[#dfe7e5] bg-white p-4 shadow-[0_18px_45px_rgba(21,61,64,0.08)] md:p-6">
        <div class="mb-6 flex flex-wrap gap-3 rounded-2xl bg-[#edf3f1] p-2">
          <button class="profile-tab is-active" data-target="estudiante" type="button">Estudiantes</button>
          <button class="profile-tab" data-target="residente" type="button">MIP MPSS R</button>
          <button class="profile-tab" data-target="medico" type="button">Médico</button>
        </div>

        <div class="mb-6 rounded-2xl border border-[#dfe7e5] bg-[#f8faf9] p-4">
          <p class="mb-2 text-sm font-semibold uppercase tracking-[0.18em] text-[#28666a]">Cargo por servicio</p>
          <p class="text-sm leading-6 text-slate-600">
            Los precios publicados no incluyen el cargo por servicio correspondiente a la operación de pago. Este cargo se calculará de acuerdo con la categoría de inscripción seleccionada y se verá reflejado en el monto total antes de finalizar el pago.
          </p>
        </div>

        <div class="profile-panel is-active" id="panel-estudiante">
          <form class="space-y-5" method="post" action="/api/orders">
            <input type="hidden" name="category" value="estudiante" />
            <div class="grid gap-5 md:grid-cols-2">
              <label class="field">
                <span>Nombre(s)</span>
                <input type="text" name="firstName" placeholder="Ej. Maria Fernanda" required />
              </label>
              <label class="field">
                <span>Apellidos</span>
                <input type="text" name="lastName" placeholder="Ej. Lopez Garcia" required />
              </label>
            </div>

            <div class="grid gap-5 md:grid-cols-2">
              <label class="field">
                <span>Correo electrónico</span>
                <input type="email" name="email" placeholder="correo@ejemplo.com" required />
              </label>
              <label class="field">
                <span>Teléfono</span>
                <input type="tel" name="phone" placeholder="(55) 0000 0000" required />
              </label>
            </div>

            <div class="grid gap-5 md:grid-cols-2">
              <label class="field">
                <span>Universidad / Institución</span>
                <input type="text" name="institution" placeholder="Nombre de la universidad" required />
              </label>
              <label class="field">
                <span>Carrera</span>
                <input type="text" name="profile_carrera" placeholder="Ej. Medicina" required />
              </label>
            </div>

            <div class="grid gap-5 md:grid-cols-2">
              <label class="field">
                <span>Semestre / nivel</span>
                <input type="text" name="profile_semestre" placeholder="Ej. 8 semestre" required />
              </label>
              <label class="field">
                <span>Matricula</span>
                <input type="text" name="registrationNumber" placeholder="Ej. A01234567" required />
              </label>
            </div>

            <div class="rounded-2xl border border-[#dfe7e5] bg-[#f8faf9] p-4">
              <p class="mb-2 text-sm font-semibold uppercase tracking-[0.18em] text-[#28666a]">Información importante</p>
              <p class="mt-2 text-sm leading-6 text-slate-600">
                La constancia entregada al final del evento sera en base a los datos proporcionados.
              </p>
            </div>

            <p class="text-sm leading-6 text-slate-600">
              Al continuar aceptas los
              <a href="/terminos-y-condiciones" class="font-semibold text-[#153d40] underline">términos y condiciones</a>.
            </p>

            <button type="submit" class="btn-primary mt-2 w-full md:w-auto">Continuar al pago</button>
          </form>
        </div>

        <div class="profile-panel" id="panel-residente">
          <form class="space-y-5" method="post" action="/api/orders">
            <input type="hidden" name="category" value="residente" />
            <div class="grid gap-5 md:grid-cols-2">
              <label class="field">
                <span>Nombre(s)</span>
                <input type="text" name="firstName" placeholder="Ej. Ana Karen" required />
              </label>
              <label class="field">
                <span>Apellidos</span>
                <input type="text" name="lastName" placeholder="Ej. Flores Diaz" required />
              </label>
            </div>

            <div class="grid gap-5 md:grid-cols-2">
              <label class="field">
                <span>Correo electrónico</span>
                <input type="email" name="email" placeholder="correo@ejemplo.com" required />
              </label>
              <label class="field">
                <span>Teléfono</span>
                <input type="tel" name="phone" placeholder="(55) 0000 0000" required />
              </label>
            </div>

            <div class="grid gap-5 md:grid-cols-2">
              <label class="field">
                <span>Hospital / sede</span>
                <input type="text" name="institution" placeholder="Nombre del hospital" required />
              </label>
              <label class="field">
                <span>Especialidad</span>
                <input type="text" name="profile_especialidad" placeholder="Ej. Cirugia general" required />
              </label>
            </div>

            <div class="grid gap-5 md:grid-cols-2">
              <label class="field">
                <span>Año de residencia</span>
                <input type="text" name="profile_anioResidencia" placeholder="Ej. R2" required />
              </label>
              <label class="field">
                <span>Matricula o cedula</span>
                <input type="text" name="registrationNumber" placeholder="Ej. RES-12345 o 1234567" required />
              </label>
            </div>

            <div class="rounded-2xl border border-[#dfe7e5] bg-[#f8faf9] p-4">
              <p class="mb-2 text-sm font-semibold uppercase tracking-[0.18em] text-[#28666a]">Información importante</p>
              <p class="mt-2 text-sm leading-6 text-slate-600">
                La constancia entregada al final del evento sera en base a los datos proporcionados.
              </p>
            </div>

            <p class="text-sm leading-6 text-slate-600">
              Al continuar aceptas los
              <a href="/terminos-y-condiciones" class="font-semibold text-[#153d40] underline">términos y condiciones</a>.
            </p>

            <button type="submit" class="btn-primary mt-2 w-full md:w-auto">Continuar al pago</button>
          </form>
        </div>

        <div class="profile-panel" id="panel-medico">
          <form class="space-y-5" method="post" action="/api/orders">
            <input type="hidden" name="category" value="medico" />
            <div class="grid gap-5 md:grid-cols-2">
              <label class="field">
                <span>Nombre(s)</span>
                <input type="text" name="firstName" placeholder="Ej. Jose Carlos" required />
              </label>
              <label class="field">
                <span>Apellidos</span>
                <input type="text" name="lastName" placeholder="Ej. Ramirez Torres" required />
              </label>
            </div>

            <div class="grid gap-5 md:grid-cols-2">
              <label class="field">
                <span>Correo electrónico</span>
                <input type="email" name="email" placeholder="correo@ejemplo.com" required />
              </label>
              <label class="field">
                <span>Teléfono</span>
                <input type="tel" name="phone" placeholder="(55) 0000 0000" required />
              </label>
            </div>

            <div class="grid gap-5 md:grid-cols-2">
              <label class="field">
                <span>Especialidad</span>
                <input type="text" name="profile_especialidad" placeholder="Ej. Medicina interna" required />
              </label>
              <label class="field">
                <span>Cédula profesional</span>
                <input type="text" name="registrationNumber" placeholder="Ej. 1234567" required />
              </label>
            </div>

            <div class="grid gap-5 md:grid-cols-2">
              <label class="field">
                <span>Institución / hospital</span>
                <input type="text" name="institution" placeholder="Nombre del centro" required />
              </label>
              <label class="field">
                <span>Cargo / puesto</span>
                <input type="text" name="profile_puesto" placeholder="Ej. Medico especialista" required />
              </label>
            </div>

            <label class="field">
              <span>Ciudad / estado</span>
              <input type="text" name="profile_ubicacion" placeholder="Ej. Monterrey, Nuevo Leon" required />
            </label>

            <div class="rounded-2xl border border-[#dfe7e5] bg-[#f8faf9] p-4">
              <p class="mb-2 text-sm font-semibold uppercase tracking-[0.18em] text-[#28666a]">Información importante</p>
              <p class="mt-2 text-sm leading-6 text-slate-600">
                La constancia entregada al final del evento sera en base a los datos proporcionados.
              </p>
            </div>

            <p class="text-sm leading-6 text-slate-600">
              Al continuar aceptas los
              <a href="/terminos-y-condiciones" class="font-semibold text-[#153d40] underline">términos y condiciones</a>.
            </p>

            <button type="submit" class="btn-primary mt-2 w-full md:w-auto">Continuar al pago</button>
          </form>
        </div>
      </section>

      <aside class="rounded-[28px] border border-[#dfe7e5] bg-[#153d40] p-6 text-white shadow-[0_18px_45px_rgba(21,61,64,0.14)]">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-[#a7b8ae]">Resumen</p>
        <h2 class="text-3xl font-black tracking-[-0.06em]">Tu acceso al congreso</h2>

        <div class="mt-6 space-y-4">
          <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
            <p class="text-sm uppercase tracking-[0.18em] text-[#cbdad7]">Evento</p>
            <p class="mt-2 text-xl font-bold">FIAM Congress 2027</p>
          </div>

          <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
            <p class="text-sm uppercase tracking-[0.18em] text-[#cbdad7]">Modalidad</p>
            <p class="mt-2 text-xl font-bold"> Presencial</p>
          </div>

          <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
            <p class="text-sm uppercase tracking-[0.18em] text-[#cbdad7]">Incluye</p>
            <ul class="mt-2 space-y-2 text-sm text-[#e9f0ee]">
              <li>• Acceso a conferencias</li>
              <li>• Material académico</li>
              <li>• Networking institucional</li>
              <li>• Certificado de participación</li>
            </ul>
          </div>
        </div>

        <div class="mt-8 rounded-2xl bg-white p-4 text-[#153d40]">
          <div class="flex items-center justify-between">
            <span class="text-sm font-semibold uppercase tracking-[0.18em] text-[#28666a]">Tipo</span>
            <span class="text-xs font-bold uppercase tracking-[0.15em] text-[#153d40]">Selecciona tu perfil</span>
          </div>
          <div class="mt-4 flex items-center justify-between">
            <span class="text-sm text-slate-600">Inscripción</span>
            <strong class="text-xl font-black" id="summary-type">Estudiante</strong>
          </div>
          <div class="mt-2 flex items-center justify-between">
            <span class="text-sm text-slate-600">Pago</span>
            <strong class="text-xl font-black" id="summary-price">Se muestra en pasarela</strong>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <script is:inline>
    const tabs = document.querySelectorAll('.profile-tab');
    const panels = document.querySelectorAll('.profile-panel');
    const summaryType = document.getElementById('summary-type');
    const summaryPrice = document.getElementById('summary-price');
    const paymentFeedback = document.getElementById('payment-feedback');

    const labels = {
      estudiante: { label: 'Estudiante' },
      residente: { label: 'Residente' },
      medico: { label: 'Médico' },
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.target;

        tabs.forEach((button) => button.classList.toggle('is-active', button === tab));
        panels.forEach((panel) => panel.classList.toggle('is-active', panel.id === `panel-${target}`));

        const profile = labels[target];

        if (profile) {
          summaryType.textContent = profile.label;
          summaryPrice.textContent = 'Se muestra en pasarela';
        }
      });
    });

    function showFormErrorFromQuery() {
      const params = new URLSearchParams(window.location.search);
      const formError = params.get('form_error');

      if (!formError) return;

      paymentFeedback.classList.remove('hidden');
      paymentFeedback.className = 'mb-6 rounded-2xl border border-[#fecaca] bg-[#fff1f2] px-4 py-3 text-sm font-semibold text-[#991b1b]';
      paymentFeedback.textContent = decodeURIComponent(formError);
    }

    async function confirmPaymentFromReturn() {
      const params = new URLSearchParams(window.location.search);
      const paymentId = params.get('payment_id') || params.get('collection_id');
      const paymentStatus = params.get('payment') || params.get('status');

      if (!paymentStatus && !paymentId) return;

      paymentFeedback.classList.remove('hidden');
      paymentFeedback.className = 'mb-6 rounded-2xl border border-[#dfe7e5] bg-white px-4 py-3 text-sm font-semibold text-[#153d40]';
      paymentFeedback.textContent = 'Procesando estado de pago...';

      if (!paymentId) {
        if (paymentStatus === 'success') {
          paymentFeedback.className = 'mb-6 rounded-2xl border border-[#b7e4ce] bg-[#f0fff4] px-4 py-3 text-sm font-semibold text-[#1b6b4a]';
          paymentFeedback.textContent = 'Pago recibido. En breve te enviaremos tu QR al correo registrado.';
        } else if (paymentStatus === 'pending') {
          paymentFeedback.className = 'mb-6 rounded-2xl border border-[#fde68a] bg-[#fffbeb] px-4 py-3 text-sm font-semibold text-[#92400e]';
          paymentFeedback.textContent = 'Tu pago está pendiente de confirmación.';
        } else {
          paymentFeedback.className = 'mb-6 rounded-2xl border border-[#fecaca] bg-[#fff1f2] px-4 py-3 text-sm font-semibold text-[#991b1b]';
          paymentFeedback.textContent = 'No se pudo confirmar el pago. Intenta nuevamente o contacta soporte.';
        }
        return;
      }

      try {
        const response = await fetch('/api/payments/confirm', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ paymentId }),
        });

        const data = await response.json();

        if (!response.ok || !data.ok) {
          throw new Error(data.message || 'No se pudo confirmar el pago.');
        }

        const status = data.result?.providerStatus;

        if (status === 'APPROVED') {
          paymentFeedback.className = 'mb-6 rounded-2xl border border-[#b7e4ce] bg-[#f0fff4] px-4 py-3 text-sm font-semibold text-[#1b6b4a]';
          paymentFeedback.textContent = 'Pago confirmado. Te enviamos tu QR de acceso al correo registrado.';
        } else if (status === 'PENDING') {
          paymentFeedback.className = 'mb-6 rounded-2xl border border-[#fde68a] bg-[#fffbeb] px-4 py-3 text-sm font-semibold text-[#92400e]';
          paymentFeedback.textContent = 'Pago pendiente de validación por el proveedor.';
        } else {
          paymentFeedback.className = 'mb-6 rounded-2xl border border-[#fecaca] bg-[#fff1f2] px-4 py-3 text-sm font-semibold text-[#991b1b]';
          paymentFeedback.textContent = 'El pago fue rechazado o cancelado. Intenta con otro método.';
        }
      } catch (error) {
        paymentFeedback.className = 'mb-6 rounded-2xl border border-[#fecaca] bg-[#fff1f2] px-4 py-3 text-sm font-semibold text-[#991b1b]';
        paymentFeedback.textContent = error instanceof Error ? error.message : 'Error al confirmar pago.';
      }
    }

    showFormErrorFromQuery();
    confirmPaymentFromReturn();
  </script>
</MainLayout>

<style>
  .profile-tab {
    flex: 1 1 180px;
    border: 1px solid transparent;
    border-radius: 14px;
    background: transparent;
    padding: 0.9rem 1.1rem;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: #153d40;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .profile-tab.is-active {
    background: #153d40;
    color: white;
    box-shadow: 0 10px 22px rgba(21, 61, 64, 0.18);
  }

  .profile-panel {
    display: none;
  }

  .profile-panel.is-active {
    display: block;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-weight: 700;
    color: #153d40;
  }

  .field span {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #28666a;
  }

  .field input,
  .field select {
    width: 100%;
    min-height: 52px;
    border: 1px solid #dfe7e5;
    border-radius: 14px;
    background: #f9faf9;
    padding: 0.9rem 1rem;
    font: inherit;
    color: #153d40;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .field input:focus,
  .field select:focus {
    border-color: #153d40;
    box-shadow: 0 0 0 4px rgba(21, 61, 64, 0.08);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 14px;
    background: #153d40;
    color: white;
    min-height: 52px;
    padding: 0.95rem 1.4rem;
    font-weight: 800;
    cursor: pointer;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    opacity: 0.96;
  }
</style>
