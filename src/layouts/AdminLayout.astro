---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-slate-100 text-slate-900">
    <div class="grid min-h-screen grid-cols-1 md:grid-cols-[240px_1fr]">
      <aside class="border-r border-slate-200 bg-white p-4">
        <h1 class="mb-6 text-lg font-semibold">Admin Congreso</h1>
        <nav class="grid gap-2 text-sm">
          <a href="/dashboard" class="rounded px-3 py-2 hover:bg-slate-100">Resumen</a>
          <a href="/dashboard/orders" class="rounded px-3 py-2 hover:bg-slate-100">Ordenes</a>
          <a href="/dashboard/attendees" class="rounded px-3 py-2 hover:bg-slate-100">Asistentes</a>
          <a href="/dashboard/tickets" class="rounded px-3 py-2 hover:bg-slate-100">Boletos</a>
          <a href="/dashboard/speakers" class="rounded px-3 py-2 hover:bg-slate-100">Ponentes</a>
          <a href="/dashboard/schedule" class="rounded px-3 py-2 hover:bg-slate-100">Programa</a>
          <a href="/dashboard/settings" class="rounded px-3 py-2 hover:bg-slate-100">Ajustes</a>
        </nav>
      </aside>
      <main class="p-6">
        <h2 class="mb-4 text-2xl font-semibold">{title}</h2>
        <slot />
      </main>
    </div>
  </body>
</html>
